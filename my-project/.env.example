# Database (required for production auth persistence on Vercel)
# Use Vercel Postgres, Neon, or Supabase and paste the connection string here.
DATABASE_URL="postgresql://user:password@host:5432/handcrafted_haven?sslmode=require"

# Optional: Vercel Postgres auto-injects these
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""

# Session cookie signing secret (set a long random string in production)
AUTH_COOKIE_SECRET="change-this-to-a-long-random-secret-in-production"
